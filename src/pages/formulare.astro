---
import BaseLayout from '../layouts/BaseLayout.astro';

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Startseite", "item": "https://av-zulassungsservice.de" },
    { "@type": "ListItem", "position": 2, "name": "Formulare",  "item": "https://av-zulassungsservice.de/formulare" },
  ]
};

const checklists = [
  {
    title: 'Neuzulassung',
    items: [
      'Zulassungsbescheinigung Teil II (Fahrzeugbrief)',
      'eVB-Nummer (von Ihrer Kfz-Versicherung)',
      'Hauptuntersuchung (HU/AU-Bericht, nicht älter als 24 Monate)',
      'Personalausweis oder Reisepass mit Meldebescheinigung',
      'SEPA-Lastschriftmandat für Kfz-Steuer (Finanzamt)',
      'Vollmacht für unseren Service (Download unten)',
    ],
  },
  {
    title: 'Ummeldung / Halterwechsel',
    items: [
      'Zulassungsbescheinigung Teil I und Teil II',
      'Personalausweis des neuen Halters',
      'eVB-Nummer des neuen Versicherers',
      'SEPA-Lastschriftmandat (neuer Halter)',
      'Vollmacht für unseren Service (Download unten)',
    ],
  },
  {
    title: 'Abmeldung',
    items: [
      'Zulassungsbescheinigung Teil I',
      'Kennzeichen (beide Schilder)',
      'Personalausweis',
    ],
  },
  {
    title: 'Wiederzulassung',
    items: [
      'Zulassungsbescheinigung Teil I und Teil II',
      'eVB-Nummer',
      'Gültige Hauptuntersuchung',
      'Personalausweis',
      'Vollmacht für unseren Service (Download unten)',
    ],
  },
];

const forms = [
  {
    title: 'Vollmacht / Auftrag',
    desc: 'Bevollmächtigt uns, in Ihrem Namen beim Straßenverkehrsamt tätig zu werden. Pflicht für alle Zulassungsvorgänge.',
    note: 'Formular herunterladen, ausfüllen, unterschreiben und uns zusenden.',
  },
  {
    title: 'SEPA-Lastschriftmandat Kfz-Steuer',
    desc: 'Für die automatische Abbuchung der Kfz-Steuer durch das Finanzamt. Wird bei Neuzulassung und Ummeldung benötigt.',
    note: 'Erhältlich beim Finanzamt oder auf der Website der Bundeszollverwaltung.',
  },
  {
    title: 'Antrag auf Außerbetriebsetzung',
    desc: 'Offizieller Antrag zur vorübergehenden oder dauerhaften Abmeldung eines Fahrzeugs.',
    note: 'Wir stellen diesen Antrag in Ihrem Namen beim Amt.',
  },
];
---

<BaseLayout
  title="Formulare & Unterlagen – AV KFZ Zulassungsservice München"
  description="Alle notwendigen Formulare und Checklisten für Ihre KFZ-Zulassung, Ummeldung oder Abmeldung beim AV KFZ Zulassungsservice München."
  canonical="https://av-zulassungsservice.de/formulare"
  jsonLd={jsonLd}
>

  <!-- Page header -->
  <section class="bg-charcoal-900 pt-14 pb-16 lg:pt-20 lg:pb-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="text-xs text-charcoal-400 mb-6" aria-label="Breadcrumb">
        <ol class="flex items-center gap-2">
          <li><a href="/" class="hover:text-white transition-colors">Startseite</a></li>
          <li aria-hidden="true">/</li>
          <li class="text-white">Formulare</li>
        </ol>
      </nav>
      <h1 class="text-4xl lg:text-5xl font-extrabold text-white tracking-tight mb-4">
        Formulare & Unterlagen
      </h1>
      <p class="text-charcoal-400 text-lg max-w-2xl leading-relaxed">
        Hier finden Sie alle benötigten Checklisten und Informationen, damit Ihr Termin reibungslos läuft.
        Unsicher? Rufen Sie uns einfach an – wir beraten Sie gerne.
      </p>
    </div>
  </section>

  <!-- Checklists -->
  <section class="bg-white py-16 lg:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="mb-12">
        <p class="section-label">Was brauche ich?</p>
        <h2 class="text-2xl lg:text-3xl font-extrabold text-charcoal-900 tracking-tight">
          Checklisten nach Leistung
        </h2>
      </div>

      <div class="grid sm:grid-cols-2 gap-6">
        {checklists.map(({ title, items }) => (
          <div class="border border-charcoal-100 rounded-xl p-6">
            <h3 class="font-bold text-charcoal-900 mb-4 flex items-center gap-2">
              <span class="w-5 h-5 rounded-full bg-crimson-500 flex items-center justify-center flex-shrink-0">
                <svg class="w-3 h-3 text-white" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                </svg>
              </span>
              {title}
            </h3>
            <ul class="space-y-2.5">
              {items.map(item => (
                <li class="flex items-start gap-2.5 text-sm text-charcoal-600">
                  <svg class="w-4 h-4 text-crimson-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"/>
                  </svg>
                  {item}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Forms info -->
  <section class="bg-charcoal-50 py-16 lg:py-20 border-t border-charcoal-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="mb-12">
        <p class="section-label">Wichtige Formulare</p>
        <h2 class="text-2xl lg:text-3xl font-extrabold text-charcoal-900 tracking-tight">
          Welche Formulare brauche ich?
        </h2>
      </div>

      <div class="grid sm:grid-cols-3 gap-6 mb-12">
        {forms.map(({ title, desc, note }) => (
          <div class="bg-white rounded-xl border border-charcoal-100 p-6">
            <div class="w-8 h-0.5 bg-crimson-500 mb-4"></div>
            <h3 class="font-bold text-charcoal-900 mb-2 text-sm">{title}</h3>
            <p class="text-charcoal-500 text-sm leading-relaxed mb-3">{desc}</p>
            <p class="text-xs text-charcoal-400 italic">{note}</p>
          </div>
        ))}
      </div>

      <div class="bg-crimson-500 rounded-2xl p-8 text-center">
        <h3 class="text-xl font-bold text-white mb-2">Unsicher, was Sie brauchen?</h3>
        <p class="text-white/75 text-sm mb-5">Wir beraten Sie kostenlos und erklären Ihnen genau, welche Unterlagen für Ihren Fall nötig sind.</p>
        <div class="flex flex-wrap justify-center gap-3">
          <a href="tel:+498921892809" class="inline-flex items-center gap-2 px-6 py-3 bg-white text-crimson-500 font-bold rounded-lg hover:bg-charcoal-50 transition-colors text-sm">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/>
            </svg>
            Jetzt anrufen
          </a>
          <a href="/kontakt" class="btn-outline-white text-sm">Kontaktformular</a>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>
