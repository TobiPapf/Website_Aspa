---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Impressum – AV KFZ Zulassungsservice München"
  description="Impressum des AV KFZ Zulassungs- und Versicherungsservice, Ludwigshafener Str. 7, 80686 München."
  canonical="https://av-zulassungsservice.de/impressum"
>

  <section class="bg-charcoal-900 pt-14 pb-14 lg:pt-20 lg:pb-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="text-xs text-charcoal-400 mb-6" aria-label="Breadcrumb">
        <ol class="flex items-center gap-2">
          <li><a href="/" class="hover:text-white transition-colors">Startseite</a></li>
          <li aria-hidden="true">/</li>
          <li class="text-white">Impressum</li>
        </ol>
      </nav>
      <h1 class="text-4xl font-extrabold text-white tracking-tight">Impressum</h1>
    </div>
  </section>

  <section class="bg-white py-14 lg:py-20">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 prose-legal">

      <h2>Angaben gemäß § 5 TMG</h2>
      <p>
        AV KFZ Zulassungs- und Versicherungsservice<br />
        Ludwigshafener Str. 7<br />
        80686 München
      </p>

