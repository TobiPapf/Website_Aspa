---
import BaseLayout from '../layouts/BaseLayout.astro';

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Startseite", "item": "https://av-zulassungsservice.de" },
    { "@type": "ListItem", "position": 2, "name": "Kontakt",    "item": "https://av-zulassungsservice.de/kontakt" },
  ]
};
---

<BaseLayout
  title="Kontakt – AV KFZ Zulassungsservice München"
  description="Kontaktieren Sie den AV KFZ Zulassungsservice in München. Telefon: +49 89 218 92 809. Ludwigshafener Str. 7, 80686 München."
  canonical="https://av-zulassungsservice.de/kontakt"
  jsonLd={jsonLd}
>

  <!-- Page header -->
  <section class="bg-charcoal-900 pt-14 pb-16 lg:pt-20 lg:pb-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="text-xs text-charcoal-400 mb-6" aria-label="Breadcrumb">
        <ol class="flex items-center gap-2">
          <li><a href="/" class="hover:text-white transition-colors">Startseite</a></li>
          <li aria-hidden="true">/</li>
          <li class="text-white">Kontakt</li>
        </ol>
      </nav>
      <h1 class="text-4xl lg:text-5xl font-extrabold text-white tracking-tight mb-4">Kontakt</h1>
      <p class="text-charcoal-400 text-lg max-w-xl leading-relaxed">
        Wir sind für Sie da – persönlich, telefonisch oder per E-Mail.
      </p>
    </div>
  </section>

  <!-- Main -->
  <section class="bg-white py-16 lg:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-14 lg:gap-20">

        <!-- Form -->
        <div>
          <h2 class="text-2xl font-extrabold text-charcoal-900 tracking-tight mb-2">Kontaktformular</h2>
          <p class="text-charcoal-500 text-sm mb-8">Wir antworten in der Regel innerhalb von 24 Stunden.</p>

          <!-- Replace YOUR_FORMSPREE_ID with your actual Formspree form ID -->
          <form
            action="https://formspree.io/f/YOUR_FORMSPREE_ID"
            method="POST"
            class="space-y-5"
            novalidate
          >
            <div class="grid sm:grid-cols-2 gap-5">
              <div>
                <label for="name" class="block text-xs font-semibold text-charcoal-700 uppercase tracking-wider mb-1.5">
                  Name <span class="text-crimson-500">*</span>
                </label>
                <input
                  id="name"
                  type="text"
                  name="name"
                  required
                  autocomplete="name"
                  placeholder="Max Mustermann"
                  class="w-full px-4 py-3 rounded-lg border border-charcoal-200 text-charcoal-900 text-sm placeholder:text-charcoal-300 focus:outline-none focus:border-crimson-500 focus:ring-2 focus:ring-crimson-500/20 transition"
                />
              </div>
              <div>
                <label for="phone" class="block text-xs font-semibold text-charcoal-700 uppercase tracking-wider mb-1.5">
                  Telefon
                </label>
                <input
                  id="phone"
                  type="tel"
                  name="phone"
                  autocomplete="tel"
                  placeholder="+49 89 ..."
                  class="w-full px-4 py-3 rounded-lg border border-charcoal-200 text-charcoal-900 text-sm placeholder:text-charcoal-300 focus:outline-none focus:border-crimson-500 focus:ring-2 focus:ring-crimson-500/20 transition"
                />
              </div>
            </div>

            <div>
              <label for="email" class="block text-xs font-semibold text-charcoal-700 uppercase tracking-wider mb-1.5">
                E-Mail <span class="text-crimson-500">*</span>
              </label>
              <input
                id="email"
                type="email"
                name="email"
                required
                autocomplete="email"
                placeholder="max@beispiel.de"
                class="w-full px-4 py-3 rounded-lg border border-charcoal-200 text-charcoal-900 text-sm placeholder:text-charcoal-300 focus:outline-none focus:border-crimson-500 focus:ring-2 focus:ring-crimson-500/20 transition"
              />
            </div>

            <div>
              <label for="service" class="block text-xs font-semibold text-charcoal-700 uppercase tracking-wider mb-1.5">
                Anliegen
              </label>
              <select
                id="service"
                name="service"
                class="w-full px-4 py-3 rounded-lg border border-charcoal-200 text-charcoal-900 text-sm focus:outline-none focus:border-crimson-500 focus:ring-2 focus:ring-crimson-500/20 transition bg-white"
              >
                <option value="">Bitte wählen …</option>
                <option>Neuzulassung</option>
                <option>Ummeldung / Halterwechsel</option>
                <option>Abmeldung</option>
                <option>Wiederzulassung</option>
                <option>Wunschkennzeichen</option>
                <option>Kurzzeitkennzeichen</option>
                <option>Versicherungsservice</option>
                <option>Export-Zulassung</option>
                <option>Sonstiges</option>
              </select>
            </div>

            <div>
              <label for="message" class="block text-xs font-semibold text-charcoal-700 uppercase tracking-wider mb-1.5">
                Nachricht <span class="text-crimson-500">*</span>
              </label>
              <textarea
                id="message"
                name="message"
                required
                rows={5}
                placeholder="Beschreiben Sie kurz Ihr Anliegen …"
                class="w-full px-4 py-3 rounded-lg border border-charcoal-200 text-charcoal-900 text-sm placeholder:text-charcoal-300 focus:outline-none focus:border-crimson-500 focus:ring-2 focus:ring-crimson-500/20 transition resize-none"
              ></textarea>
            </div>

            <div class="flex items-start gap-3">
              <input
                id="privacy"
                type="checkbox"
                name="privacy"
                required
                class="mt-0.5 w-4 h-4 rounded border-charcoal-300 text-crimson-500 focus:ring-crimson-500"
              />
              <label for="privacy" class="text-xs text-charcoal-500 leading-relaxed">
                Ich habe die <a href="/datenschutz" class="text-crimson-500 underline underline-offset-2">Datenschutzerklärung</a> gelesen
                und stimme der Verarbeitung meiner Daten zur Bearbeitung meiner Anfrage zu.
              </label>
            </div>

            <button
              type="submit"
              class="btn-primary w-full justify-center"
            >
              Anfrage absenden
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/>
              </svg>
            </button>
          </form>
        </div>

        <!-- Contact info -->
        <div class="space-y-8">
          <div>
            <h2 class="text-2xl font-extrabold text-charcoal-900 tracking-tight mb-6">
              So erreichen Sie uns
            </h2>

            <div class="space-y-5">
              <!-- Phone -->
              <div class="flex gap-4 items-start">
                <div class="w-10 h-10 rounded-lg bg-crimson-50 flex items-center justify-center flex-shrink-0">
                  <svg class="w-5 h-5 text-crimson-500" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/>
                  </svg>
                </div>
                <div>
                  <p class="text-xs text-charcoal-400 mb-1">Festnetz</p>
                  <a href="tel:+498921892809" class="font-bold text-charcoal-900 hover:text-crimson-500 transition-colors">
                    +49 89 218 92 809
                  </a>
                  <p class="text-xs text-charcoal-400 mt-0.5">Mo – Fr 08:00 – 18:00 · Sa 09:00 – 13:00</p>
                </div>
              </div>

              <!-- Mobile -->
              <div class="flex gap-4 items-start">
                <div class="w-10 h-10 rounded-lg bg-crimson-50 flex items-center justify-center flex-shrink-0">
                  <svg class="w-5 h-5 text-crimson-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"/>
                  </svg>
                </div>
                <div>
                  <p class="text-xs text-charcoal-400 mb-1">Mobil</p>
                  <a href="tel:+4915735700222" class="font-bold text-charcoal-900 hover:text-crimson-500 transition-colors">
                    +49 157 35 700 222
                  </a>
                </div>
              </div>

              <!-- Email -->
              <div class="flex gap-4 items-start">
                <div class="w-10 h-10 rounded-lg bg-crimson-50 flex items-center justify-center flex-shrink-0">
                  <svg class="w-5 h-5 text-crimson-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                  </svg>
                </div>
                <div>
                  <p class="text-xs text-charcoal-400 mb-1">E-Mail</p>
                  <a href="mailto:info@av-zulassungsservice.de" class="font-bold text-charcoal-900 hover:text-crimson-500 transition-colors text-sm">
                    info@av-zulassungsservice.de
                  </a>
                </div>
              </div>

              <!-- Address -->
              <div class="flex gap-4 items-start">
                <div class="w-10 h-10 rounded-lg bg-crimson-50 flex items-center justify-center flex-shrink-0">
                  <svg class="w-5 h-5 text-crimson-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                  </svg>
                </div>
                <div>
                  <p class="text-xs text-charcoal-400 mb-1">Adresse</p>
                  <address class="not-italic font-semibold text-charcoal-900 text-sm leading-relaxed">
                    Ludwigshafener Str. 7<br />
                    80686 München
                  </address>
                </div>
              </div>
            </div>
          </div>

          <!-- Opening hours -->
          <div class="bg-charcoal-50 rounded-xl border border-charcoal-100 p-6">
            <h3 class="font-bold text-charcoal-900 mb-4 text-sm">Öffnungszeiten</h3>
            <dl class="space-y-2 text-sm">
              {[
                { day: 'Montag – Freitag', hours: '08:00 – 18:00' },
                { day: 'Samstag',          hours: '09:00 – 13:00' },
                { day: 'Sonntag',          hours: 'Geschlossen'   },
              ].map(({ day, hours }) => (
                <div class="flex justify-between gap-4">
                  <dt class="text-charcoal-500">{day}</dt>
                  <dd class={`font-medium ${hours === 'Geschlossen' ? 'text-charcoal-400' : 'text-charcoal-900'}`}>{hours}</dd>
                </div>
              ))}
            </dl>
          </div>

          <!-- Rückruf -->
          <div class="bg-crimson-50 rounded-xl border border-crimson-100 p-6">
            <h3 class="font-bold text-charcoal-900 mb-2 text-sm">Lieber Rückruf?</h3>
            <p class="text-charcoal-500 text-sm mb-4 leading-relaxed">
              Hinterlassen Sie Ihre Nummer im Kontaktformular und wir rufen Sie zu einer für Sie passenden Zeit zurück.
            </p>
            <a href="tel:+498921892809" class="btn-primary text-sm !py-2.5">
              Direkt anrufen
            </a>
          </div>
        </div>

      </div>
    </div>
  </section>

</BaseLayout>
